# Example environment variables for CKD-CI
# Copy to .env and update values for your environment

# Database URL (Postgres)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/ckdci

# Application secrets
SECRET_KEY=CHANGE_ME_TO_A_STRONG_SECRET
ENV=development
DEBUG=True

# Optional Sentry DSN
SENTRY_DSN=

# Model bundle path (optional if using default)
MODEL_BUNDLE_PATH=./models/ckd_model_bundle.joblib

# Admin bootstrap credentials (used by scripts/create_admin.py)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs
